# Path the app calls the back-end on. Kept relative so the API is served from
# this app's own origin (Vercel rewrite in prod, Vite proxy in dev) and the
# BE's auth cookies are first-party — see the README's Deployment section.
VITE_BE_URL=/api

# Where the dev proxy forwards /api. No VITE_ prefix on purpose: this must not
# be bundled into client code. Defaults to http://localhost:3001 if unset.
DEV_PROXY_TARGET=http://localhost:3001

VITE_PAYPAL_CLIENT_ID=

# Stripe's publishable key (pk_test_… / pk_live_…), of the same account as the
# back-end's secret key. Leave it empty to offer PayPal only.
VITE_STRIPE_PUBLISHABLE_KEY=
